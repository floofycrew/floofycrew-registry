{
  "schema": 1,
  "id": "rimuru-branding",
  "name": "Rimuru branding",
  "version": "2.0.0",
  "description": "The Rimuru slime theme as a FloofyCrew mod: the Level-1 theme pack (colours, logo, favicon, bot name 'Great Sage') installed through the host's own theme seam. Since 2.0.0 a pure theme pack: the first frame and the theme-reset guard come from the custom-themes mod it depends on, so no boot script and no patch of its own. Unofficial fan theme; see README.md for artwork attribution.",
  "authors": [
    "Oscar Tseng"
  ],
  "license": "MIT",
  "tags": [
    "theme",
    "branding",
    "rimuru"
  ],
  "kirocrew": {
    "version": ">=0.7.0 <0.9.0",
    "editions": [
      "internal",
      "external"
    ],
    "strict": false
  },
  "dependsOn": {
    "floofycrew": ">=1.1.0 <2.0.0",
    "custom-themes": {
      "range": ">=1.0.0 <2.0.0",
      "reason": "applies the first-frame sheet for every installed custom theme and the theme-reset guard; before 2.0.0 this mod shipped both itself"
    }
  },
  "parts": [
    {
      "kind": "theme",
      "side": "gateway",
      "path": "theme/theme.json",
      "description": "the Level-1 pack; the host renders its branding (logo, favicon, bot name) natively since 0.7.0, custom-themes paints its palette on the first frame"
    }
  ],
