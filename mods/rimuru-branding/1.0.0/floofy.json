{
  "schema": 1,
  "id": "rimuru-branding",
  "name": "Rimuru branding",
  "version": "1.0.0",
  "description": "The Rimuru slime theme as a FloofyCrew mod: the Level-1 theme pack (colours, logo, favicon, bot name 'Great Sage') installed through the host's own theme seam, a first-frame boot part so the palette, favicon and logo paint before the dashboard hydrates (no launch flash, cold clients included), and an import-map patch that neutralises the dashboard's persisting theme reset. Unofficial fan theme; see README.md for artwork attribution.",
  "authors": [
    "liyent"
  ],
  "license": "MIT",
  "tags": [
    "theme",
    "branding",
    "first-frame",
    "rimuru"
  ],
  "kirocrew": {
    "version": ">=0.7.0 <0.9.0",
    "editions": [
      "internal",
      "external"
    ],
    "strict": false
  },
  "dependsOn": {
    "floofycrew": ">=0.0.0 <2.0.0"
  },
  "parts": [
    {
      "kind": "theme",
      "side": "gateway",
      "path": "theme/theme.json",
      "description": "the Level-1 pack; the host renders its branding (logo, favicon, bot name) natively since 0.7.0"
    },
    {
      "kind": "spa",
      "side": "spa",
      "path": "spa/boot.js",
      "activation": "boot",
      "boot": {
        "css": "spa/boot.css",
        "favicon": "theme/branding/favicon.png",
        "logo": "theme/branding/logo.png",
        "when": {
          "theme": "custom-rimuru"
        }
      },
      "description": "first frame: baked pack CSS, favicon and logo before hydration; theme bootstrap from localStorage / host config"
    },
    {
      "kind": "patch",
      "side": "spa",
      "path": "patches/theme-reset-guard.json",
      "description": "import-map patch on the useTheme chunk: the persisting theme reset becomes a no-op"
    }
  ],
  "files": [
    {
      "path": "README.md",
      "sha256": "bb5f91472e295b7de6a3c209da620bcfdc1fc9cf2de3995c50d65df1ea33b768"
